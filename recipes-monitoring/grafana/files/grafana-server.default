# Runtime configuration for grafana-server.service
# Settings reference: https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/

GRAFANA_USER=grafana
GRAFANA_GROUP=grafana
GRAFANA_HOME=/usr/share/grafana

CONF_DIR=/etc/grafana
CONF_FILE=/etc/grafana/grafana.ini
PROVISIONING_CFG_DIR=/etc/grafana/provisioning

# The database and any plugins installed later are dynamic data, so they
# sit on the /data partition and outlive a rootfs update
DATA_DIR=/data/grafana
PLUGINS_DIR=/data/grafana/plugins
LOG_DIR=/var/log/grafana

PID_FILE_DIR=/run/grafana
MAX_OPEN_FILES=10000
