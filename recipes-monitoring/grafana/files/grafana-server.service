[Unit]
Description=Grafana observability and data visualization platform
Documentation=https://grafana.com/docs/
# Ordered after the network stack is up, but deliberately not after
# network-online.target: Grafana binds to all interfaces and retries its
# data source connections, so it should come up with or without a link.
After=network.target

[Service]
Type=simple
User=grafana
Group=grafana
EnvironmentFile=/etc/default/grafana-server
WorkingDirectory=/usr/share/grafana
RuntimeDirectory=grafana
RuntimeDirectoryMode=0750
ExecStart=/usr/share/grafana/bin/grafana server \
    --config=${CONF_FILE} \
    --pidfile=${PID_FILE_DIR}/grafana-server.pid \
    --homepath=${GRAFANA_HOME} \
    cfg:default.paths.logs=${LOG_DIR} \
    cfg:default.paths.data=${DATA_DIR} \
    cfg:default.paths.plugins=${PLUGINS_DIR} \
    cfg:default.paths.provisioning=${PROVISIONING_CFG_DIR}
Restart=on-failure
RestartSec=5
LimitNOFILE=10000
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
