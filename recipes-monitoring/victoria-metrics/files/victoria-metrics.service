[Unit]
Description=VictoriaMetrics time series database
Documentation=https://docs.victoriametrics.com
# Ordered after the network stack is up, but deliberately not after
# network-online.target: the listen address is a wildcard, so the database
# should come up with or without a link.
After=network.target
# The database sits on the /data partition, which has to be mounted first
RequiresMountsFor=/data

[Service]
Type=simple
User=victoriametrics
Group=victoriametrics
# Fallback for a device whose /etc/default file predates this setting: the
# file is a conffile and survives an upgrade, while this unit does not, and an
# empty -search.latencyOffset= would keep the service from starting. Listed
# before EnvironmentFile so the file wins wherever it defines the variable.
Environment=VM_SEARCH_LATENCY_OFFSET=0s
EnvironmentFile=/etc/default/victoria-metrics
# A mount covers whatever the rootfs ships under /data, so the data
# directory is created here rather than packaged by the recipe. The "+"
# runs these as root, before the drop to the victoriametrics user.
ExecStartPre=+/bin/mkdir -p ${VM_STORAGE_DATA_PATH}
ExecStartPre=+/bin/chown victoriametrics:victoriametrics ${VM_STORAGE_DATA_PATH}
ExecStartPre=+/bin/chmod 0750 ${VM_STORAGE_DATA_PATH}
ExecStart=/usr/bin/victoria-metrics-prod \
    -storageDataPath=${VM_STORAGE_DATA_PATH} \
    -httpListenAddr=${VM_HTTP_LISTEN_ADDR} \
    -retentionPeriod=${VM_RETENTION_PERIOD} \
    -search.latencyOffset=${VM_SEARCH_LATENCY_OFFSET} \
    $VM_OPTS
Restart=on-failure
RestartSec=5
# VictoriaMetrics keeps many data part files open
LimitNOFILE=65536
# Give the database time to flush in-memory parts to disk
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
