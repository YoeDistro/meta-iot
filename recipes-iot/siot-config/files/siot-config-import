#!/bin/sh
# Import the versioned Simple IoT configuration into the local instance.
#
# The import runs one time: it records a stamp file on success and returns
# early whenever that stamp is present. Pass --force to import again, which
# is worth reaching for after the shipped configuration changes.
#
# Simple IoT adds nodes on import rather than replacing them, so a second
# import leaves the nodes from the first in place and adds another copy
# alongside them. Remove the earlier nodes, from the web interface or
# through the API, whenever a clean result matters.
#
# Reference: https://docs.simpleiot.org/docs/user/configuration.html

set -eu

CONFIG=${SIOT_CONFIG_FILE:-/etc/siot/config.yml}
STAMP=${SIOT_CONFIG_STAMP:-/data/siot/.config-imported}
TRIES=${SIOT_CONFIG_TRIES:-30}
RETRY_SECS=${SIOT_CONFIG_RETRY_SECS:-2}

force=no

usage() {
	cat <<EOF
Usage: ${0##*/} [-f|--force]

Import $CONFIG into the Simple IoT instance on this device.

  -f, --force  Import even when $STAMP
               records an earlier import. Simple IoT adds nodes rather
               than replacing them, so this leaves a second copy of every
               node the earlier import created.
  -h, --help   Show this message.

The systemd unit stands down once the stamp file exists, so run a forced
import by hand:

  ${0##*/} --force
EOF
}

while [ $# -gt 0 ]; do
	case $1 in
	-f | --force)
		force=yes
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "Unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

if [ -e "$STAMP" ] && [ "$force" = no ]; then
	echo "Configuration already imported, recorded in $STAMP"
	echo "Pass --force to import it again"
	exit 0
fi

if [ ! -r "$CONFIG" ]; then
	echo "Configuration file $CONFIG is missing" >&2
	exit 1
fi

# Wait for the store to come up. Export is a read the instance only answers
# once it is serving requests, so it doubles as the readiness check.
try=1
while :; do
	if [ -n "$(siot export 2>/dev/null || true)" ]; then
		break
	fi

	if [ "$try" -ge "$TRIES" ]; then
		echo "Simple IoT did not answer after $TRIES tries" >&2
		exit 1
	fi

	try=$((try + 1))
	sleep "$RETRY_SECS"
done

if [ -e "$STAMP" ]; then
	echo "Importing again over the record in $STAMP"
	echo "Nodes from the earlier import stay in place, so expect a second copy"
fi

# The configuration describes a whole tree, starting at its own device
# node, so it goes in at the root rather than beneath a node the instance
# generated.
echo "Importing $CONFIG at the root"
siot import -parentID root <"$CONFIG"

mkdir -p "$(dirname "$STAMP")"
{
	echo "config: $CONFIG"
	echo "parent: root"
	echo "date: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
	if [ "$force" = yes ]; then
		echo "forced: yes"
	fi
	sha256sum "$CONFIG" 2>/dev/null || true
} >"$STAMP"

echo "Import complete, recorded in $STAMP"
