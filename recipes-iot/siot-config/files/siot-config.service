[Unit]
Description=Import the Simple IoT node configuration
Documentation=https://docs.simpleiot.org/docs/user/configuration.html
Requires=siot.service
After=siot.service
# The import runs once. The stamp file lives beside the store, so clearing
# the store also clears the stamp and the configuration is imported again.
ConditionPathExists=!/var/lib/siot/.config-imported
ConditionPathExists=/etc/siot/config.yml

[Service]
Type=oneshot
RemainAfterExit=yes
# Picks up SIOT_NATS_PORT and SIOT_AUTH_TOKEN when the file is present
EnvironmentFile=-/etc/default/siot
ExecStart=/usr/libexec/siot-config-import

[Install]
WantedBy=multi-user.target
