[Unit]
Description=Import the Simple IoT node configuration
Documentation=https://docs.simpleiot.org/docs/user/configuration.html
Requires=siot.service
After=siot.service
# The store sits on the /data partition, which has to be mounted before the
# stamp file below can be found
RequiresMountsFor=/data
# The import runs once. The stamp file lives beside the store, so clearing
# the store also clears the stamp and the configuration is imported again.
# This condition also holds back `systemctl start siot-config`, so run a
# later import by hand with `siot-config-import --force`.
ConditionPathExists=!/data/siot/.config-imported
ConditionPathExists=/etc/siot/config.yml

[Service]
Type=oneshot
RemainAfterExit=yes
# Gives the siot command the same connection settings siot.service runs with
EnvironmentFile=-/etc/default/siot
ExecStart=/usr/bin/siot-config-import

[Install]
WantedBy=multi-user.target
