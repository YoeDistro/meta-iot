[Unit]
Description=Simple IoT edge and cloud application framework
Documentation=https://docs.simpleiot.org
# Ordered after the network stack is up, but deliberately not after
# network-online.target: siot binds to wildcard addresses and reconnects
# upstream on its own, so it should come up with or without a link.
After=network.target
# The store sits on the /data partition, which has to be mounted first
RequiresMountsFor=/data

[Service]
Type=simple
EnvironmentFile=/etc/default/siot
# A mount covers whatever the rootfs ships under /data, so the store
# directory is created here rather than packaged by the recipe.
ExecStartPre=/bin/mkdir -p ${SIOT_DATA}
ExecStart=/usr/bin/siot serve
Restart=on-failure
RestartSec=5
# Give the embedded store time to sync its JetStream files on shutdown
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
