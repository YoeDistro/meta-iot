# Runtime configuration for siot.service
# Reference: https://docs.simpleiot.org

# Directory holding the SimpleIoT store, a JetStream directory since v0.23.0.
# On the /data partition so that it outlives a rootfs update.
SIOT_DATA=/data/siot

# Port the built-in web portal listens on
SIOT_HTTP_PORT=8118

# Ports used by the embedded NATS server
SIOT_NATS_PORT=4222
SIOT_NATS_HTTP_PORT=8222
SIOT_NATS_WS_PORT=9222

# History kept per subject in the JetStream store. Retention is per subject,
# so the current value of every point survives and only older history is
# trimmed. Unset, SimpleIoT keeps 5000 per subject; -1 keeps everything. A new
# value applies to each stream the first time it is opened after a restart,
# and JetStream trims subjects that already hold more. The recipe fills this
# in when SIOT_STORE_MAX_MSGS_PER_SUBJECT is set in the build configuration.
#SIOT_STORE_MAX_MSGS_PER_SUBJECT=5000

# Field in /etc/os-release reported as the device OS version
OS_VERSION_FIELD=VERSION

# Set to require a token for NATS connections, e.g. SIOT_AUTH_TOKEN=<token>
#SIOT_AUTH_TOKEN=

# Set to connect this instance upstream to another SimpleIoT instance
#SIOT_NATS_SERVER=nats://example.com:4222

# Directory of provisioning files applied at start-up and whenever they
# change. Unset, SimpleIoT reads ${SIOT_DATA}/provisioning when that directory
# exists. The siot-config package ships a drop-in naming its own directory in
# the rootfs, so set this only to point somewhere else.
#SIOT_PROVISIONING_DIR=/etc/siot/provisioning
