# Runtime configuration for siot.service
# Reference: https://docs.simpleiot.org

# Directory holding the SimpleIoT store (siot.sqlite and its WAL files)
SIOT_DATA=/var/lib/siot

# Port the built-in web portal listens on
SIOT_HTTP_PORT=8118

# Ports used by the embedded NATS server
SIOT_NATS_PORT=4222
SIOT_NATS_HTTP_PORT=8222
SIOT_NATS_WS_PORT=9222

# Field in /etc/os-release reported as the device OS version
OS_VERSION_FIELD=VERSION

# Set to require a token for NATS connections, e.g. SIOT_AUTH_TOKEN=<token>
#SIOT_AUTH_TOKEN=

# Set to connect this instance upstream to another SimpleIoT instance
#SIOT_NATS_SERVER=nats://example.com:4222
